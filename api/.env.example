# Application
NODE_ENV=production
PORT=3001

# Supabase PostgreSQL (Session pooler — port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=10&pool_timeout=15"

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT Secrets — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend — resend.com)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
FINANCE_EMAIL=finance@yourcompany.com

# Frontend URL for CORS (comma-separated, add your Vercel URL)
FRONTEND_URL=https://your-app.vercel.app
