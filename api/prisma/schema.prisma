generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  FINANCE
  BILL_HEAD
  ADMIN
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  FINANCE_APPROVED
  PAID
  REJECTED
}

enum ApprovalAction {
  MANAGER_APPROVED
  MANAGER_REJECTED
  FINANCE_APPROVED
  FINANCE_REJECTED
  MARKED_PAID
  REOPENED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         Role      @default(EMPLOYEE)
  accountNo    String?   @map("account_no")
  iban         String?
  swift        String?
  bankName     String?   @map("bank_name")
  department   String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  claims              Claim[]
  approvals           Approval[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  attachments         Attachment[]
  assignedClaims      Claim[]              @relation("AssignedFinanceClaims")
  financeAccess       ClaimFinanceAccess[] @relation("ClaimFinanceAccessUser")
  financeInvitesSent  ClaimFinanceAccess[] @relation("ClaimFinanceInvitedBy")

  @@map("users")
}

model Claim {
  id                String      @id @default(uuid())
  claimNumber       String      @unique @map("claim_number")
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id])
  assignedFinanceId String?     @map("assigned_finance_id")
  assignedFinance   User?       @relation("AssignedFinanceClaims", fields: [assignedFinanceId], references: [id])
  eventName         String?     @map("event_name")
  purpose           String?
  department        String?
  status            ClaimStatus @default(DRAFT)
  totalAed          Decimal     @default(0) @map("total_aed") @db.Decimal(12, 2)
  totalEur          Decimal     @default(0) @map("total_eur") @db.Decimal(12, 2)
  notes             String?
  submittedAt       DateTime?   @map("submitted_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  items         ClaimItem[]
  approvals     Approval[]
  auditLogs     AuditLog[]
  attachments   Attachment[]
  financeAccess ClaimFinanceAccess[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("claims")
}

model ClaimFinanceAccess {
  id          String   @id @default(uuid())
  claimId     String   @map("claim_id")
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  financeId   String   @map("finance_id")
  finance     User     @relation("ClaimFinanceAccessUser", fields: [financeId], references: [id])
  invitedById String   @map("invited_by_id")
  invitedBy   User     @relation("ClaimFinanceInvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([claimId, financeId])
  @@index([claimId])
  @@index([financeId])
  @@map("claim_finance_access")
}

model ClaimItem {
  id               String    @id @default(uuid())
  claimId          String    @map("claim_id")
  claim            Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  lineOrder        Int       @map("line_order")
  expenseDate      DateTime  @map("expense_date")
  categoryCode     String    @map("category_code")
  categoryName     String    @map("category_name")
  plCostTypeNr     String?   @map("pl_cost_type_nr")
  plCostTypeName   String?   @map("pl_cost_type_name")
  pillarName       String?   @map("pillar_name")
  description      String
  country          String?
  currency         String    @default("AED")
  originalAmount   Decimal   @map("original_amount") @db.Decimal(12, 2)
  exchangeRateUsed Decimal   @default(1) @map("exchange_rate_used") @db.Decimal(10, 6)
  aedAmount        Decimal   @map("aed_amount") @db.Decimal(12, 2)
  eurAmount        Decimal   @map("eur_amount") @db.Decimal(12, 2)
  receiptNumber    String?   @map("receipt_number")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  attachments Attachment[]

  @@index([claimId])
  @@map("claim_items")
}

model Attachment {
  id           String     @id @default(uuid())
  claimId      String?    @map("claim_id")
  claim        Claim?     @relation(fields: [claimId], references: [id])
  claimItemId  String?    @map("claim_item_id")
  claimItem    ClaimItem? @relation(fields: [claimItemId], references: [id])
  uploadedById String     @map("uploaded_by_id")
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  filename     String
  originalName String     @map("original_name")
  mimeType     String     @map("mime_type")
  fileSize     Int        @map("file_size")
  storagePath  String     @map("storage_path")
  bucket       String
  isCompressed Boolean    @default(false) @map("is_compressed")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([claimId])
  @@index([claimItemId])
  @@map("attachments")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  baseCurrency   String   @default("AED") @map("base_currency")
  targetCurrency String   @map("target_currency")
  rate           Decimal  @db.Decimal(10, 6)
  effectiveDate  DateTime @map("effective_date")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([baseCurrency, targetCurrency, effectiveDate])
  @@index([targetCurrency, effectiveDate])
  @@map("exchange_rates")
}

model Approval {
  id         String         @id @default(uuid())
  claimId    String         @map("claim_id")
  claim      Claim          @relation(fields: [claimId], references: [id])
  approverId String         @map("approver_id")
  approver   User           @relation(fields: [approverId], references: [id])
  action     ApprovalAction
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([claimId])
  @@map("approvals")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  claimId    String?  @map("claim_id")
  claim      Claim?   @relation(fields: [claimId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([claimId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
